# Neo4j Graph Memory Configuration
NEO4J_URI=127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=AvoHarness2026!SecureGraph
NEO4J_DATABASE=neo4j

# Ollama Configuration
# Mode flag: "local" or "cloud"
OLLAMA_MODE=local

# Model selection from env (e.g. qwen2.5-coder:7b, llama3.2, mistral, etc.)
OLLAMA_MODEL=

# Local Ollama Settings (when OLLAMA_MODE=local)
OLLAMA_URL=http://127.0.0.1:11434

# Cloud Ollama Settings (when OLLAMA_MODE=cloud)
# OLLAMA_MODE=cloud
# OLLAMA_URL=https://api.ollama.com
# OLLAMA_MODEL=
OLLAMA_API_KEY=
